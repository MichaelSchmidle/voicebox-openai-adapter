# Replace this value before starting the adapter. Never commit a populated .env.
ADAPTER_API_KEY=replace-with-a-long-random-secret

# Use a trusted, administrator-controlled Voicebox URL.
VOICEBOX_BASE_URL=http://voicebox:17493
# VOICEBOX_API_KEY=replace-with-a-separate-upstream-secret
VOICEBOX_CLIENT_ID=openai-adapter

# Optional profile mapping for OpenAI stock voice names.
# VOICEBOX_DEFAULT_PROFILE=profile-name-or-id
VOICEBOX_DEFAULT_ENGINE=qwen
VOICEBOX_ALLOWED_ENGINES=qwen,qwen_custom_voice,luxtts,chatterbox,chatterbox_turbo,tada,kokoro

VOICEBOX_REQUEST_TIMEOUT_SECONDS=600
VOICEBOX_HEALTH_TIMEOUT_SECONDS=5
MAX_INPUT_CHARS=4096
MAX_AUDIO_BYTES=104857600
FFMPEG_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO
